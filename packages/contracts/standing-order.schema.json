{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulseos.dev/contracts/standing-order.schema.json",
  "title": "PulseOS Compiled Standing Order",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trigger_event_types", "action_templates", "explanation"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "trigger_event_types": {
      "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
      "items": { "enum": ["travel_booked", "travel_changed", "client_opportunity", "client_confirmed", "salary_credited", "subscription_renewal", "generic_important_event"] }
    },
    "entity_conditions": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/entityCondition" } },
    "action_templates": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/actionTemplate" } },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "warnings": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 240 } }
  },
  "$defs": {
    "entityCondition": {
      "type": "object", "additionalProperties": false, "required": ["field", "operator"],
      "properties": { "field": { "type": "string", "minLength": 1, "maxLength": 80 }, "operator": { "enum": ["equals", "contains", "exists"] }, "value": { "type": ["string", "number", "boolean", "null"] } }
    },
    "actionTemplate": {
      "type": "object", "additionalProperties": false,
      "required": ["action_type", "connector", "input", "risk_level", "approval_mode"],
      "properties": {
        "action_type": { "enum": ["travel.create_folder", "travel.create_calendar_event", "travel.get_weather", "travel.generate_documents", "travel.notify_family", "client.create_repository", "client.generate_documents", "client.create_calendar_event", "client.notify_client", "salary.update_budget", "salary.propose_transfer"] },
        "connector": { "enum": ["google", "github", "telegram", "mock_bank", "weather", "internal"] },
        "input": { "type": "object", "maxProperties": 32 },
        "risk_level": { "enum": ["green", "yellow", "red"] },
        "approval_mode": { "enum": ["automatic", "approval_required", "blocked"] }
      },
      "allOf": [{ "if": { "properties": { "risk_level": { "const": "red" } } }, "then": { "properties": { "approval_mode": { "not": { "const": "automatic" } } } } }]
    }
  }
}
