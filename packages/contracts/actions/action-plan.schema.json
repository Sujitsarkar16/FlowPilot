{
  "title": "FlowPilot Action Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "event_id", "objective", "status", "actions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "policy_checked", "running", "waiting_approval", "completed", "partially_completed", "failed", "cancelled"]},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "connector", "input", "status", "risk_level", "policy_decision", "approval_status", "depends_on"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "connector": {"type": "string", "minLength": 1},
          "input": {"type": "object"},
          "status": {"enum": ["planned", "blocked", "waiting_approval", "approved", "queued", "running", "completed", "failed", "cancelled", "rolled_back"]},
          "risk_level": {"enum": ["green", "yellow", "red"]},
          "policy_decision": {"enum": ["automatic", "approval_required", "blocked"]},
          "approval_status": {"enum": ["not_required", "pending", "approved", "rejected"]},
          "depends_on": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
