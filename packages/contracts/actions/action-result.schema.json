{
  "title": "PulseOS Action Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action_id", "status", "output", "rollback_supported"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "action_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["verified", "failed", "rolled_back"]},
    "external_reference": {"type": "string"},
    "output": {"type": "object"},
    "verified_at": {"type": "string", "format": "date-time"},
    "rollback_supported": {"type": "boolean"},
    "rollback_descriptor": {"type": "object"}
  }
}
