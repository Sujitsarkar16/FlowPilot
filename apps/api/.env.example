# Local development configuration (untracked)
FLOWPILOT_ENV=development
DEMO_MODE=false
# Render Free can run both workers in the API process while the web service is awake.
RUN_EMBEDDED_WORKERS=false
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres

# Local browser sessions and Google OpenID Connect login. Generate both auth secrets as
# random 32-byte urlsafe base64 values and keep them outside version control.
AUTH_APP_URL=http://localhost:3000
AUTH_SESSION_SECRET=
AUTH_STATE_SECRET=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Sensitive endpoint throttles and maximum inbound body size in bytes.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MANUAL_EVENTS=30
RATE_LIMIT_WEBHOOKS=60
RATE_LIMIT_AI_REQUESTS=10
REQUEST_BODY_LIMIT_BYTES=1048576
# Maximum decoded size of a single event attachment. Base64 request overhead is accounted for.
EVENT_ATTACHMENT_MAX_BYTES=5242880
# Maximum allowed age for signed inbound webhook timestamps.
WEBHOOK_TIMESTAMP_WINDOW_SECONDS=300
# Keep the dependency-free, process-local Prometheus endpoint private unless explicitly enabled.
METRICS_ENABLED=false

# Optional connector configuration. Store real values only in the untracked .env file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connections/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/connections/github/callback
CONNECTION_SUCCESS_URL=http://localhost:3000/dashboard/connections
TELEGRAM_BOT_TOKEN=
# Enables a local, credential-free Telegram bot for demonstrations only.
TELEGRAM_MOCK_MODE=true
# Shared secret required by the simulated salary-credit webhook.
MOCK_BANK_WEBHOOK_SECRET=
# Simplified client-kickoff availability window (local weekday hours).
CLIENT_AVAILABILITY_START_HOUR=10
CLIENT_AVAILABILITY_END_HOUR=16

# Provider-neutral structured AI. Point AI_BASE_URL at any OpenAI-compatible endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
CORS_ORIGINS=http://localhost:3000
